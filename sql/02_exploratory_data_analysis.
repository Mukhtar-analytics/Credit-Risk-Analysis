-- EDA step1: Volume Overview
-- =============================================================================================
select count(*) as the_total_of_borrowers
 from credit_risk2;
 
 
 select count(*) as total_of_borrowers,
 sum(case when loan_status = 1 then 1 else 0 end ) as Total_Defaulters,
 concat(round(sum(case when loan_status = 1 then 1 else 0 end) / count(*) * 100,2), "%") as persent_of_total_defaulters,
 sum(case when loan_status = 0 then 1 else 0 end) as Non_Defaulters,
 concat(round(sum(case when loan_status = 0 then 1 else 0 end) / count(*) * 100,2), "%") as persent_of_non_defaulters
 from credit_risk2;
 
 -- ==================================================================================
 -- Interest_Analysis
 -- Average Interest Rate Overall
 
 SELECT concat(round(AVG(loan_int_rate),2),"%") AS OVERALL_INT_RATE
 FROM credit_risk2;

 -- what is the difference between the average interest rate for defaulters and non-defaulters
 
 SELECT LOAN_STATUS, 
 concat(round(avg(loan_int_rate),2),"%") AS loan_int_rate1
 FROM credit_risk2
 group by loan_status
;

-- what is the average of each loan grade?

 select loan_grade,
concat(round(avg(loan_int_rate),2),"%") as loan_int_rate_G
 from credit_risk2
 group by loan_grade
 order by 2 desc;
 
 -- what is the average of each loan intent?
 select loan_intent, concat(round(avg(loan_int_rate),2),"%") as loan_intent_rate
 from credit_risk2
 group by loan_intent
 order by 2 desc;
 
 select loan_intent,
 sum(case when loan_status = 1 then 1 else 0 end ) as Total_Defaulters
 from credit_risk2
 group by loan_intent;
 
