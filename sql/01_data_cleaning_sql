-- Project: Credit Risk Datasets cleaning and tranformation 
-- script: Data cleaning pipline 
-- discription : preparing raw credit risk data for EDA and visualizition
-- step1: data staging 

create table credit_risk1
like credit_risk;

insert credit_risk1
select *
from credit_risk;

------------------------------------------------------------------------------
-- step2: checking for duplicate rows 


with duplicate_rows as (
select *, 
row_number() over(partition by person_age,person_income,person_home_ownership,person_emp_length,loan_intent,loan_grade,
loan_amnt,loan_int_rate,loan_status,loan_percent_income,
cb_person_default_on_file,cb_person_cred_hist_length) as row_dup
from credit_risk1)
select * 
from duplicate_rows
where row_dup > 1;

create table credit_risk2 as (select *, 
row_number() over(partition by person_age,person_income,person_home_ownership,person_emp_length,loan_intent,loan_grade,
loan_amnt,loan_int_rate,loan_status,loan_percent_income,
cb_person_default_on_file,cb_person_cred_hist_length) as row_dup
from credit_risk1);

delete
from credit_risk2
where row_dup > 1;

------------------------------------------------------------------------------------------
-- step3: standardize data

select distinct* 
from credit_risk2
order by 1;

-- standardizing loan_intent column values

select concat(upper(left(loan_intent,1)),
 lower(substring(loan_intent,2))) as formated_loan_column
 from credit_risk2;
 
 update credit_risk2
 set loan_intent = concat(upper(left(loan_intent,1)),
 lower(substring(loan_intent,2)));
 
 -- seperate the merged values in loan_intent column
 select distinct
 replace(loan_intent, 'Debtconsolidation', 'Debt consolidation'),
 replace(loan_intent, 'Homeimprovement', 'Home improvement') as fixed_row
from credit_risk2 ;

update credit_risk2
set loan_intent = replace(replace(loan_intent, 'Debtconsolidation', 'Debt consolidation'),
 'Homeimprovement', 'Home improvement');
 
 select distinct*
 from credit_risk2;
 
-- standardizing person_home_column values

select concat(upper(left(person_home_ownership,1)),
 lower(substring(person_home_ownership, 2))) as fixed_val
from credit_risk2;

update credit_risk2
set person_home_ownership =  concat(upper(left(person_home_ownership,1)),
 lower(substring(person_home_ownership, 2))) ;
 
 
 select
 sum(case when person_home_ownership is null then 1 else 0 end )as person_null,
sum(case when person_age is null or " " then 1 else 0 end ) as age_null,
sum(case when person_income is null then 1 else 0 end ) as inc,
sum(case when person_emp_length is null then 1 else 0 end ) as len,
sum(case when loan_intent is null then 1 else 0 end ) as intent,
sum(case when loan_grade is null then 1 else 0 end ) as gr,
sum(case when loan_amnt is null then 1 else 0 end ) as amou,
sum(case when loan_int_rate is null then 1 else 0 end ) as int_rate,
sum(case when loan_status is null then 1 else 0 end ) as  stat,
sum(case when loan_percent_income is null then 1 else 0 end ) as percen_inco,
sum(case when cb_person_default_on_file is null then 1 else 0 end ) as defau,
sum(case when cb_person_cred_hist_length is null then 1 else 0 end ) as hist
from credit_risk2;

 -- transforming empty values into null values
 
 update credit_risk2
 set loan_int_rate = null
 where trim(loan_int_rate) = '' or loan_int_rate is null;
 
update credit_risk2
set person_emp_length = null
where trim(person_emp_length) = '' or person_emp_length is null;
 
 -- Offset empty values with the average interest rate of same credit group

UPDATE credit_risk2 t
JOIN (
    SELECT loan_grade, ROUND(AVG(loan_int_rate), 2) AS avg_rate
    FROM credit_risk2
    WHERE loan_int_rate IS NOT NULL
    GROUP BY loan_grade)g 
    ON t.loan_grade = g.loan_grade
SET t.loan_int_rate = g.avg_rate
WHERE t.loan_int_rate IS NULL;

